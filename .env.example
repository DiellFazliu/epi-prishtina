# Copy to .env and replace placeholders with private values.
# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# Application
APP_NAME=EpiPrishtina
APP_VERSION=1.0.0
DEBUG=true
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://epi_user:REPLACE_WITH_PRIVATE_PASSWORD@localhost:6000/epiprishtina
DATABASE_ECHO=false
POSTGRES_USER=epi_user
POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
POSTGRES_DB=epiprishtina
POSTGRES_HOST_PORT=6000
POSTGRES_CONTAINER_PORT=5432

# Redis
REDIS_URL=redis://:REPLACE_WITH_PRIVATE_REDIS_PASSWORD@localhost:6379/0
REDIS_PASSWORD=REPLACE_WITH_PRIVATE_REDIS_PASSWORD
REDIS_PUBSUB_CHANNEL=epiprishtina:updates
REDIS_HOST_PORT=6379
REDIS_CONTAINER_PORT=6379
CELERY_BROKER_URL=redis://:REPLACE_WITH_PRIVATE_REDIS_PASSWORD@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_PRIVATE_REDIS_PASSWORD@localhost:6379/2

# JWT
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (JSON list for Pydantic settings)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000","http://localhost:8080"]

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_WS_URL=ws://localhost:8000/ws

# Local authentication tests only; never use these values in production.
TEST_ADMIN_USERNAME=admin
TEST_ADMIN_EMAIL=admin@example.invalid
TEST_ADMIN_PASSWORD=REPLACE_WITH_TEST_ONLY_PASSWORD
TEST_ACCESS_TOKEN=REPLACE_WITH_ACCESS_TOKEN_FOR_WEBSOCKET_TEST
